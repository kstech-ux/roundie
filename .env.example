# ROUNDIE LP — environment template
# Copy to .env and fill in. Never commit .env.

# GA4 (1st party proxy)
GA4_ID=G-XXXXXXX
GA4_PROXY_ENDPOINT=https://analytics.kanopy.app/g/collect

# Form backend
FORM_ENDPOINT=https://api.roundie.app/early-access
DKIM_DOMAIN=mail.roundie.app

# Deploy
CF_PAGES_PROJECT=roundie-lp
CF_ACCOUNT_ID=
CF_API_TOKEN=

# CSP nonce (rotated per request, build step injects)
CSP_REPORT_URI=https://csp.kanopy.app/report
